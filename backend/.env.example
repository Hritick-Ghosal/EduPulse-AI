@"
MONGO_DB_USER=your_mongodb_atlas_username
MONGO_DB_PASSWORD=your_mongodb_atlas_password
MONGO_DB_CLUSTER=your_cluster.mongodb.net
MONGO_DB_NAME=edupulse_db
GROQ_API_KEY=your_groq_api_key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
"@ | Set-Content -Encoding UTF8 backend\.env.example
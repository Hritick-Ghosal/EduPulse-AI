# ==============================================================================
# EduPulse AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and fill in your actual credentials.

# Django Settings
DJANGO_SECRET_KEY=django-insecure-edupulse-ai-dev-secret-key-change-in-production
DEBUG=True

# MongoDB Atlas (Required for Student Portal Auth & Chat History)
# Get your free cluster at: https://www.mongodb.com/cloud/atlas
MONGO_DB_USER=your_mongodb_atlas_username
MONGO_DB_PASSWORD=your_mongodb_atlas_password
MONGO_DB_CLUSTER=your_cluster.mongodb.net
MONGO_DB_NAME=edupulse_db

# Groq LPU API (Required for Student AI Chat & Dynamic Quiz Generator)
# Get a free fast inference API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Allowed CORS Origins (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:80,http://localhost,http://127.0.0.1

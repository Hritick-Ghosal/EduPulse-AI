# ==============================================================================
# EduPulse AI — Master Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env in the project root:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Django API Backend Configuration
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-edupulse-ai-dev-secret-key-change-in-production
DEBUG=True

# ------------------------------------------------------------------------------
# 2. MongoDB Atlas Configuration (Student Chat & Auth)
# ------------------------------------------------------------------------------
# Register for a free MongoDB Atlas cluster: https://www.mongodb.com/cloud/atlas
MONGO_DB_USER=your_mongo_user
MONGO_DB_PASSWORD=your_mongo_password
MONGO_DB_CLUSTER=your_cluster.mongodb.net
MONGO_DB_NAME=edupulse_db

# ------------------------------------------------------------------------------
# 3. Groq LPU Generative AI API (Student AI Assistant)
# ------------------------------------------------------------------------------
# Generate your free fast inference key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 4. CORS Origins (Allowed frontend web endpoints)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:80,http://localhost,http://127.0.0.1

# ------------------------------------------------------------------------------
# 5. Frontend Build Configuration (Optional Docker defaults)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/academics
VITE_STUDENT_APP_URL=http://localhost:5173
